{
  "expo": {
    "name": "Belote",
    "slug": "belote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A1535",
      "dark": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#0A1535"
      }
    },
    "scheme": "sallycards",
    "ios": {
      "bundleIdentifier": "com.sallycards.belote",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Belote utilise votre position pour la carte des hkim."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyAa1lBSroSXA-Om4mio84-SWAcmzQgYv8w"
      }
    },
    "android": {
      "package": "com.sallycards.belote",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAa1lBSroSXA-Om4mio84-SWAcmzQgYv8w"
        }
      },
      "versionCode": 7
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0A1535",
          "imageWidth": 1242
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Belote utilise votre position pour la carte des hkim."
        }
      ]
    ],
    "newArchEnabled": true,
    "extra": {
      "usesCleartextTraffic": true,
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "05085663-e463-4489-bd47-8b41ff6cce62"
      }
    },
    "owner": "idriss.kriouile"
  }
}
